<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculatrice_Donfack.MainPage"
             Shell.NavBarIsVisible="False">

    <!-- Fond de page : dégradé bleu nuit -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#070A14" Offset="0.0" />
            <GradientStop Color="#0E1226" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>

        <!-- Style commun : boutons en forme de gélule, avec effet d'appui -->
        <Style x:Key="BoutonBase" TargetType="Button">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="40" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.93" />
                                <Setter Property="Opacity" Value="0.8" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- Chiffres et virgule : gris anthracite bleuté -->
        <Style x:Key="BoutonChiffre" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
            <Setter Property="BackgroundColor" Value="#1A2036" />
            <Setter Property="BorderColor" Value="#2A3352" />
            <Setter Property="TextColor" Value="#EEF1FF" />
        </Style>

        <!-- Fonctions (retour arrière, pourcentage, signe) : bleu ciel sur fond sombre -->
        <Style x:Key="BoutonFonction" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
            <Setter Property="BackgroundColor" Value="#142338" />
            <Setter Property="BorderColor" Value="#1F3A5C" />
            <Setter Property="TextColor" Value="#7DD3FC" />
            <Setter Property="FontSize" Value="24" />
        </Style>

        <!-- Touche C : rouge corail -->
        <Style x:Key="BoutonEffacer" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
            <Setter Property="BackgroundColor" Value="#2B1620" />
            <Setter Property="BorderColor" Value="#5A2434" />
            <Setter Property="TextColor" Value="#FF6B81" />
            <Setter Property="FontSize" Value="24" />
        </Style>

        <!-- Opérateurs : dégradé violet indigo -->
        <Style x:Key="BoutonOperateur" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#9B7CFF" Offset="0.0" />
                    <GradientStop Color="#5B3DF5" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Égal : dégradé menthe vers cyan, pour ressortir -->
        <Style x:Key="BoutonEgal" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="TextColor" Value="#04141C" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#34E8B5" Offset="0.0" />
                    <GradientStop Color="#0EA5E9" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <!-- Layout 1 : Grid de fond, qui laisse une marge autour du « corps » de la calculatrice -->
    <Grid Padding="14">

        <!-- Layout 2 : Border, le corps arrondi de la calculatrice, avec ombre lumineuse -->
        <Border x:Name="CorpsBorder"
                Stroke="#2A3150"
                StrokeThickness="1.5"
                Padding="14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="40" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#171C31" Offset="0.0" />
                    <GradientStop Color="#0B0E1B" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="#7C5CFF" Opacity="0.35" Radius="40" Offset="0,12" />
            </Border.Shadow>

            <!-- Grid racine de la calculatrice : portrait = écran en haut, clavier en bas
                 (la disposition paysage est gérée dans OnSizeAllocated) -->
            <Grid x:Name="RacineGrid"
                  RowSpacing="12"
                  ColumnSpacing="12"
                  RowDefinitions="2*,5*">

                <!-- Écran d'affichage -->
                <Border x:Name="AffichageBorder"
                        Grid.Row="0"
                        Grid.Column="0"
                        Stroke="#2B3352"
                        StrokeThickness="1"
                        Padding="20,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1B2140" Offset="0.0" />
                            <GradientStop Color="#0F1328" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid RowDefinitions="Auto,*">

                        <!-- Layout 3 : HorizontalStackLayout, barre de titre de l'écran -->
                        <HorizontalStackLayout Grid.Row="0" Spacing="10">
                            <BoxView WidthRequest="8"
                                     HeightRequest="8"
                                     CornerRadius="4"
                                     Color="#34E8B5"
                                     VerticalOptions="Center" />
                            <Label Text="CALCULATRICE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="3"
                                   TextColor="#7C8AB8"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Layout 4 : VerticalStackLayout, opération en cours au-dessus du résultat -->
                        <VerticalStackLayout Grid.Row="1" VerticalOptions="End" Spacing="2">

                            <Label x:Name="ExpressionLabel"
                                   Text=""
                                   FontSize="20"
                                   TextColor="#8B95B5"
                                   HorizontalTextAlignment="End"
                                   LineBreakMode="HeadTruncation"
                                   MaxLines="1" />

                            <!-- Layout 5 : ScrollView horizontal, un long résultat défile au lieu de déborder -->
                            <ScrollView x:Name="ResultatScroll"
                                        Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never"
                                        HorizontalOptions="End">
                                <Label x:Name="ResultatLabel"
                                       Text="0"
                                       FontSize="64"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="NoWrap"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </ScrollView>

                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Grid du clavier : 5 lignes et 4 colonnes de taille égale, qui s'adaptent à l'écran -->
                <Grid x:Name="ClavierGrid"
                      Grid.Row="1"
                      Grid.Column="0"
                      RowDefinitions="*,*,*,*,*"
                      ColumnDefinitions="*,*,*,*">

                    <!-- Ligne 0 -->
                    <Button Grid.Row="0" Grid.Column="0" Text="C"
                            Style="{StaticResource BoutonEffacer}"
                            Clicked="OnToutEffacerClicked"
                            SemanticProperties.Description="Tout effacer" />
                    <Button Grid.Row="0" Grid.Column="1" Text="⌫"
                            Style="{StaticResource BoutonFonction}"
                            Clicked="OnRetourArriereClicked"
                            SemanticProperties.Description="Effacer le dernier caractère" />
                    <Button Grid.Row="0" Grid.Column="2" Text="%"
                            Style="{StaticResource BoutonFonction}"
                            Clicked="OnPourcentageClicked"
                            SemanticProperties.Description="Pourcentage" />
                    <Button Grid.Row="0" Grid.Column="3" Text="÷"
                            Style="{StaticResource BoutonOperateur}"
                            Clicked="OnOperateurClicked"
                            SemanticProperties.Description="Diviser" />

                    <!-- Ligne 1 -->
                    <Button Grid.Row="1" Grid.Column="0" Text="7" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="1" Grid.Column="1" Text="8" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="1" Grid.Column="2" Text="9" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="1" Grid.Column="3" Text="×"
                            Style="{StaticResource BoutonOperateur}"
                            Clicked="OnOperateurClicked"
                            SemanticProperties.Description="Multiplier" />

                    <!-- Ligne 2 -->
                    <Button Grid.Row="2" Grid.Column="0" Text="4" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="2" Grid.Column="1" Text="5" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="2" Grid.Column="2" Text="6" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="2" Grid.Column="3" Text="−"
                            Style="{StaticResource BoutonOperateur}"
                            Clicked="OnOperateurClicked"
                            SemanticProperties.Description="Soustraire" />

                    <!-- Ligne 3 -->
                    <Button Grid.Row="3" Grid.Column="0" Text="1" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="3" Grid.Column="1" Text="2" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="3" Grid.Column="2" Text="3" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="3" Grid.Column="3" Text="+"
                            Style="{StaticResource BoutonOperateur}"
                            Clicked="OnOperateurClicked"
                            SemanticProperties.Description="Additionner" />

                    <!-- Ligne 4 -->
                    <Button Grid.Row="4" Grid.Column="0" Text="±"
                            Style="{StaticResource BoutonFonction}"
                            Clicked="OnChangementSigneClicked"
                            SemanticProperties.Description="Changer le signe" />
                    <Button Grid.Row="4" Grid.Column="1" Text="0" Style="{StaticResource BoutonChiffre}" Clicked="OnChiffreClicked" />
                    <Button Grid.Row="4" Grid.Column="2" Text=","
                            Style="{StaticResource BoutonChiffre}"
                            Clicked="OnVirguleClicked"
                            SemanticProperties.Description="Virgule décimale" />
                    <Button Grid.Row="4" Grid.Column="3" Text="="
                            Style="{StaticResource BoutonEgal}"
                            Clicked="OnEgalClicked"
                            SemanticProperties.Description="Calculer le résultat" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
